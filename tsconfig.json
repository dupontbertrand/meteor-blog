{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "meteor/*": ["./.meteor/types/packages/*"],
      "/imports/*": ["./imports/*"]
    }
  },
  "files": ["./.meteor/types/packages.d.ts"],
  "include": ["client/**/*", "server/**/*", "imports/**/*", "type-tests/**/*.ts"]
}
