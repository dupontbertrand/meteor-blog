{
  "name": "meteor-blog",
  "private": true,
  "scripts": {
    "start": "meteor run",
    "test": "TEST_CLIENT=0 meteor test --once --driver-package meteortesting:mocha",
    "test:e2e": "playwright test",
    "types": "meteor types",
    "typecheck": "meteor types && tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.5",
    "@swc/helpers": "^0.5.23",
    "bootstrap": "^5.3.3",
    "jquery": "^3.7.1",
    "meteor-node-stubs": "^1.2.12",
    "mjml": "^4.15.3",
    "uglify-js": "^3.19.3"
  },
  "devDependencies": {
    "@meteorjs/rspack": "^3.0.0",
    "@playwright/test": "^1.65.0",
    "@rsdoctor/rspack-plugin": "^1.6.4",
    "@rspack/cli": "^2.2.7",
    "@rspack/core": "^2.2.7",
    "@rspack/dev-server": "^2.2.1",
    "@swc/core": "^1.16.2",
    "@types/mjml": "^4.7.4",
    "@types/node": "^26.6.3",
    "chai": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.js"
    },
    "testModule": {
      "client": false,
      "server": "tests/main.js"
    },
    "modern": true
  }
}
